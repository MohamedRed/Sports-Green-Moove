{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sportgreenmoove.local/release-evidence.schema.json",
  "title": "Sports Green-mOOVe Release Evidence Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "releaseCandidate",
    "generatedAt",
    "owner",
    "providerProductionReadiness",
    "postponedSocialAuthReadiness",
    "automatedUserFlowEvidence",
    "realDeviceRuns",
    "storeReviewEvidence",
    "safetyAuditEvidence",
    "operationalUserFlowEvidence"
  ],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "template": { "type": "boolean" },
    "releaseCandidate": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "providerProductionReadiness": {
      "type": "object",
      "required": ["firebase", "radar", "googleMaps", "stripeConnect"]
    },
    "postponedSocialAuthReadiness": {
      "type": "object",
      "required": ["googleSignIn", "metaFacebook"]
    },
    "automatedUserFlowEvidence": {
      "type": "object",
      "required": ["items"]
    },
    "realDeviceRuns": {
      "type": "array",
      "minItems": 2
    },
    "storeReviewEvidence": {
      "type": "object",
      "required": ["items"]
    },
    "safetyAuditEvidence": {
      "type": "object",
      "required": ["items"]
    },
    "operationalUserFlowEvidence": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "description", "evidenceRefs"],
            "allOf": [{
              "if": { "properties": { "id": { "enum": [
                "team_push_closed_app_delivery", "team_push_notification_tap", "team_push_current_account_isolation",
                "team_push_revocation_suppression", "team_push_permission_lifecycle", "team_push_signout_cleanup",
                "booking_ride_chat_access_revocation"
              ] } } },
              "then": {
                "required": ["platformRuns"],
                "properties": {
                  "platformRuns": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "$ref": "#/$defs/operationalPlatformRun" },
                    "allOf": [
                      { "contains": { "properties": { "platform": { "const": "ios" } } }, "minContains": 1 },
                      { "contains": { "properties": { "platform": { "const": "android" } } }, "minContains": 1 }
                    ]
                  }
                }
              }
            }]
          }
        }
      }
    }
  },
  "$defs": {
    "operationalPlatformRun": {
      "type": "object", "additionalProperties": false, "required": ["platform", "status"],
      "properties": {
        "platform": { "enum": ["ios", "android"] },
        "status": { "enum": ["pending", "passed", "failed"] },
        "deviceKind": { "const": "physical" },
        "deviceModel": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 },
        "appBuild": { "type": "string", "minLength": 1 },
        "tester": { "type": "string", "minLength": 1 },
        "completedAt": { "type": "string", "format": "date-time" },
        "observedResult": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "passed" } } },
        "then": { "required": ["deviceKind", "deviceModel", "osVersion", "appBuild", "tester", "completedAt", "observedResult", "evidenceRefs"] }
      }]
    }
  }
}
