rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024;
    }

    match /clubs/{clubId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.resource.size < 10 * 1024 * 1024;
    }

    match /reports/{reportId}/{fileName} {
      allow read, write: if signedIn() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}

