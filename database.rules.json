{
  "rules": {
    "liveTrips": {
      "$rideSessionId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && $userId === auth.uid"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
