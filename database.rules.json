{
  "rules": {
    "liveTrips": {
      "$rideSessionId": {
        ".read": "auth != null",
        ".write": false,
        "vehicle": {
          ".write": "auth != null && newData.child('userId').val() === auth.uid"
        },
        "children": {
          "$childUserId": {
            ".write": "auth != null && $childUserId === auth.uid"
          }
        }
      }
    },
    "presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && $userId === auth.uid"
      }
    }
  }
}

